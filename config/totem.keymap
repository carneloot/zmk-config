//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>

#define Base        0
#define Media       1
#define Nav         2
#define Mouse       3
#define Sym         4
#define Num         5
#define Fun         6
#define Button      7
#define Game        8
#define Gameplus    9

&mt {
    quick-tap-ms = <100>;
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
};

&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
};

/ {
    behaviors {
        hrm_l: hrm_l {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <80>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <15 26 27 16 5 6 7 28 17 8 18 29 30 19 9 31 5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
        };

        hrm_r: hrm_r {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <80>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
        };

        lt_sym: lt_sym {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;

            flavor = "tap-unless-interrupted";
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        change-screen-r {
            bindings = <&kp LC(LG(RIGHT))>;
            key-positions = <7 8>;
            layers = <2>;
        };

        change-screen-l {
            bindings = <&kp LC(LG(LEFT))>;
            key-positions = <7 6>;
            layers = <2>;
        };

        tilde {
            bindings = <&kp TILDE>;
            key-positions = <6 7>;
            layers = <0 10>;
        };

        move-window-r {
            bindings = <&kp LG(LS(RIGHT))>;
            key-positions = <28 29>;
            layers = <2>;
        };

        move-window-l {
            bindings = <&kp LG(LS(LEFT))>;
            key-positions = <27 28>;
            layers = <2>;
        };

        grave {
            bindings = <&kp GRAVE>;
            key-positions = <7 8>;
            layers = <0 10>;
        };

        cedilha {
            bindings = <&kp RA(COMMA)>;
            key-positions = <23 24>;
            layers = <0 10>;
        };

        move-workspace-r {
            bindings = <&kp LG(LS(PAGE_DOWN))>;
            key-positions = <3 2>;
            layers = <2>;
        };

        move-workspace-l {
            bindings = <&kp LG(LS(PAGE_UP))>;
            key-positions = <2 1>;
            layers = <2>;
        };

        colon {
            bindings = <&kp COLON>;
            key-positions = <2 3>;
            layers = <0 10>;
        };

        quote {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <2 1>;
            layers = <0 10>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
                     &kp Q          &kp W          &kp F           &kp P            &kp B        &kp J            &kp L           &kp U           &kp Y          &kp SQT
                     &hrm_l LGUI A  &hrm_l LALT R  &hrm_l LCTRL S  &hrm_l LSHIFT T  &kp G        &kp M            &hrm_r RSHFT N  &hrm_r RCTRL E  &hrm_r LALT I  &hrm_r RGUI O
&mt LSHIFT LEFT_GUI  &lt 5 Z        &kp X          &kp C           &kp D            &kp V        &kp K            &kp H           &kp COMMA       &kp DOT        &lt 5 SLASH    &kp LA(LC(SPACE))
                                                   &lt 4 ESC       &lt 2 SPACE      &lt 1 TAB    &lt_sym 3 ENTER  &lt 2 BSPC      &lt 6 DELETE
            >;
        };

        Media {
            bindings = <
        &trans  &trans  &kp LC(V)  &kp LC(C)  &kp LC(X)    &kp LC(X)       &kp LC(C)         &kp LC(V)        &trans      &trans
        &trans  &trans  &trans     &trans     &trans       &kp C_PREVIOUS  &kp C_VOL_DN      &kp C_VOLUME_UP  &kp C_NEXT  &trans
&trans  &trans  &trans  &trans     &trans     &trans       &trans          &kp LC(Z)         &kp LS(LC(Z))    &trans      &trans  &trans
                        &trans     &trans     &trans       &kp C_STOP      &kp C_PLAY_PAUSE  &kp C_MUTE
            >;

            display-name = "Media";
        };

        Nav {
            display-name = "Nav";
            bindings = <
        &trans  &kp HOME     &kp UP_ARROW  &kp END    &kp SINGLE_QUOTE    &kp EQUAL        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS
        &trans  &kp LEFT     &kp DOWN      &kp RIGHT  &kp GRAVE           &kp KP_MULTIPLY  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS
&trans  &trans  &kp PAGE_UP  &none         &kp PG_DN  &none               &kp PERIOD       &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp KP_DIVIDE  &trans
                             &trans        &trans     &trans              &trans           &trans        &kp NUMBER_0
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
        &trans  &kp BACKSLASH  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp SEMICOLON    &trans  &trans  &trans  &trans  &trans
        &trans  &kp PIPE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL        &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans         &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp UNDER        &trans  &trans  &trans  &trans  &trans  &trans
                               &trans                &trans                 &trans           &trans  &trans  &trans
            >;
        };

        Fun {
            display-name = "Fun";
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &kp PRINTSCREEN  &kp F7  &kp F8  &kp F9  &kp F10
        &trans  &trans  &trans  &trans  &trans    &kp INS          &kp F4  &kp F5  &kp F6  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans    &kp PAUSE_BREAK  &kp F1  &kp F2  &kp F3  &kp F12  &kp SCROLLLOCK
                        &trans  &trans  &trans    &trans           &trans  &trans
            >;
        };

        Button {
            display-name = "Button";
            bindings = <
             &bt BT_CLR         &trans  &trans  &trans  &bt BT_SEL 0    &trans  &trans  &trans  &trans  &bootloader
             &trans             &trans  &trans  &trans  &bt BT_SEL 1    &trans  &to 10  &trans  &trans  &trans
&bootloader  &ext_power EP_TOG  &trans  &trans  &trans  &bt BT_SEL 2    &trans  &to 0   &to 7   &to 8   &trans       &trans
                                        &trans  &trans  &trans          &trans  &trans  &trans
            >;
        };

        Cmds {
            bindings = <
        &trans  &trans  &trans             &trans        &trans    &trans  &kp LC(Z)  &kp LC(LS(Z))  &trans     &trans
        &trans  &trans  &kp LC(LA(SPACE))  &kp CAPSLOCK  &trans    &trans  &kp LC(C)  &kp LC(V)      &kp LC(S)  &trans
&trans  &trans  &trans  &trans             &trans        &trans    &trans  &trans     &trans         &trans     &trans  &trans
                        &trans             &trans        &trans    &trans  &trans     &trans
            >;
        };

        OW {
            bindings = <
         &kp TAB    &kp Q  &kp W     &kp E      &kp R          &trans  &trans         &trans  &trans  &trans
         &kp LSHFT  &kp A  &kp S     &kp D      &kp F          &trans  &trans         &trans  &trans  &trans
&kp ESC  &kp LCTRL  &kp Z  &kp X     &kp C      &kp V          &trans  &trans         &trans  &trans  &trans  &to 0
                           &kp LALT  &kp SPACE  &mt GRAVE H    &trans  &kp BACKSPACE  &trans
            >;
        };

        LoL {
            bindings = <
         &kp TAB     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4    &trans  &trans         &trans  &trans  &trans
         &kp LSHIFT  &kp Q         &kp W         &kp E         &kp R           &trans  &trans         &trans  &trans  &trans
&kp ESC  &kp LCTRL   &kp A         &kp S         &kp D         &kp F           &trans  &trans         &trans  &trans  &trans  &to 0
                                   &kp LALT      &kp SPACE     &sl 9           &trans  &kp BACKSPACE  &trans
            >;
        };

        LoL2 {
            bindings = <
        &trans  &kp NUMBER_5  &kp NUMBER_6  &kp NUMBER_7  &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &trans        &kp O         &kp P         &kp T     &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans        &trans        &trans        &trans    &trans  &trans  &trans  &trans  &trans  &trans
                              &trans        &trans        &trans    &trans  &trans  &trans
            >;
        };

        qwerty {
            display-name = "QWERTY";
            bindings = <
                     &kp Q          &kp W          &kp E           &kp R            &kp T        &kp Y        &kp U           &kp I           &kp O          &kp P
                     &hrm_l LGUI A  &hrm_l LALT S  &hrm_l LCTRL D  &hrm_l LSHIFT F  &kp G        &kp H        &hrm_r RSHFT J  &hrm_r RCTRL K  &hrm_r LALT L  &hrm_r RGUI SQT
&mt LSHIFT LEFT_GUI  &lt 5 Z        &kp X          &kp C           &kp V            &kp B        &kp N        &kp M           &kp COMMA       &kp DOT        &lt 5 SLASH      &to 0
                                                   &lt_sym 4 ESC   &lt 2 SPACE      &lt 1 TAB    &lt 3 ENTER  &lt 2 BSPC      &lt 6 DELETE
            >;
        };
    };
};
